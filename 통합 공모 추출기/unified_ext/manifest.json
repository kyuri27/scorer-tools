{
  "manifest_version": 3,
  "name": "공모 정보 추출기 (세움터·나라장터·범용)",
  "version": "1.0",
  "description": "세움터·나라장터 공모 정보 자동 추출, 기타 사이트는 AI로 추출합니다.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "downloads", "debugger", "webNavigation"],
  "host_permissions": ["*://*.eais.go.kr/*", "*://*.g2b.go.kr/*", "*://*.hub.go.kr/*", "https://generativelanguage.googleapis.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
